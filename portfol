    // =========================================================================
    // 220 kV POWER GRID & SCADA DIGITAL-TWIN CANVAS ENGINE
    // =========================================================================
    function initPowerGridCanvas() {
      const canvas = document.getElementById('power-grid-canvas');
      const ctx = canvas.getContext('2d');

      const FEEDER_NODES = [
        { id: 'f1', label: 'FDR 01: GTU Education (7.78)', angle: -2.2, dist: 155, color: '#38bdf8', target: '#bay-edu', kv: '132 kV' },
        { id: 'f2', label: 'FDR 02: GETCO 220kV Sub.', angle: -0.9, dist: 185, color: '#10b981', target: '#bay-getco', kv: '220 kV', subs: ['Morbi AIS', 'Siddheshwar GIS', 'Hadala'] },
        { id: 'f3', label: 'FDR 03: Plant Watering MCU', angle: 0.25, dist: 170, color: '#06b6d4', target: '#bay-automation', kv: '24V DC' },
        { id: 'f4', label: 'FDR 04: Fertilizer PLC Timer', angle: 1.15, dist: 180, color: '#f59e0b', target: '#bay-automation', kv: '24V DC' },
        { id: 'f5', label: 'FDR 05: Protection & SCADA', angle: 2.15, dist: 165, color: '#a855f7', target: '#bay-skills', kv: '220 kV' },
        { id: 'f6', label: 'FDR 06: Dispatch & Comms', angle: 3.05, dist: 150, color: '#6366f1', target: '#bay-dispatch', kv: 'Telemetry' }
      ];

      const hitNodes = [];
      let phaseOffset = 0;

      function resize() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      resize();
      window.addEventListener('resize', resize);

      function drawGridFrame() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        const scrollY = window.scrollY || 0;
        const maxScroll = Math.max(1, document.body.scrollHeight - window.innerHeight);
        const scrollRatio = Math.min(1, Math.max(0, scrollY / maxScroll));

        const lfBar = document.getElementById('load-flow-bar');
        if (lfBar) lfBar.style.width = `${(scrollRatio * 100).toFixed(1)}%`;

        // Transition center from Top Open Stage (at scroll=0) to Right Viewport Dock (during scroll)
        const stageT = Math.min(1, scrollY / 420);
        const isDesktop = canvas.width >= 1024;
        const rightDockX = canvas.width * 0.785;
        const cx = isDesktop
          ? (canvas.width * 0.5) * (1 - stageT) + rightDockX * stageT
          : canvas.width * 0.5;
        const topStageY = Math.min(285, canvas.height * 0.43);
        const scrollStageY = isDesktop ? canvas.height * 0.50 : canvas.height * 0.25;
        const cy = topStageY * (1 - stageT) + scrollStageY * stageT;
        const scale = isDesktop
          ? (1.02 * (1 - stageT) + 0.78 * stageT) * Math.min(1.15, canvas.width / 1280)
          : Math.min(0.75, Math.max(0.48, canvas.width / 660));

        // 1. Subtle SCADA Blueprint Grid Background
        ctx.save();
        ctx.strokeStyle = 'rgba(6, 182, 212, 0.05)';
        ctx.lineWidth = 1;
        const step = 44;
        for (let x = 0; x < canvas.width; x += step) {
          ctx.beginPath();
          ctx.moveTo(x, 0);
          ctx.lineTo(x, canvas.height);
          ctx.stroke();
        }
        for (let y = 0; y < canvas.height; y += step) {
          ctx.beginPath();
          ctx.moveTo(0, y);
          ctx.lineTo(canvas.width, y);
          ctx.stroke();
        }
        ctx.restore();

        // 2. Live 3-Phase R-Y-B Sinusoidal Oscilloscope Waveform Ribbon below the Hub
        phaseOffset += (state.hz / 50) * 0.08;
        const waveY = cy + 215 * scale;
        const waveW = 340 * scale;
        const waveX0 = cx - waveW / 2;
        const amp = (state.kv / 220) * 16 * scale;

        ctx.save();
        ctx.fillStyle = 'rgba(2, 6, 23, 0.85)';
        ctx.strokeStyle = 'rgba(6, 182, 212, 0.35)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.roundRect(waveX0 - 12, waveY - 28 * scale, waveW + 24, 56 * scale, 10);
        ctx.fill();
        ctx.stroke();

        const phases = [
          { color: '#ef4444', shift: 0 },
          { color: '#eab308', shift: (2 * Math.PI) / 3 },
          { color: '#3b82f6', shift: (4 * Math.PI) / 3 }
        ];
        for (const ph of phases) {
          ctx.beginPath();
          ctx.strokeStyle = ph.color;
          ctx.lineWidth = 1.6;
          for (let i = 0; i <= waveW; i += 4) {
            const rad = (i / waveW) * Math.PI * 4 - phaseOffset + ph.shift;
            const yVal = waveY + Math.sin(rad) * amp;
            if (i === 0) ctx.moveTo(waveX0 + i, yVal);
            else ctx.lineTo(waveX0 + i, yVal);
          }
          ctx.stroke();
        }
        ctx.fillStyle = '#94a3b8';
        ctx.font = `600 ${Math.max(8, Math.round(9.5 * scale))}px "JetBrains Mono", monospace`;
        ctx.textAlign = 'center';
        ctx.fillText(`3Φ R-Y-B LIVE OSCILLOSCOPE (${state.kv} kV • ${state.hz.toFixed(1)} Hz)`, cx, waveY - 16 * scale);
        ctx.restore();

        // 3. Draw Concentric Substation Bus Rings
        ctx.save();
        ctx.beginPath();
        ctx.arc(cx, cy, 85 * scale, 0, Math.PI * 2);
        ctx.strokeStyle = state.faultActive ? 'rgba(244, 63, 94, 0.65)' : 'rgba(6, 182, 212, 0.28)';
        ctx.lineWidth = 2;
        ctx.setLineDash([6, 4]);
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(cx, cy, 170 * scale, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(16, 185, 129, 0.22)';
        ctx.lineWidth = 1.5;
        ctx.stroke();
        ctx.restore();

        // 4. Draw Radial Feeder Transmission Lines & Moving Current Packets
        const now = Date.now();
        hitNodes.length = 0;

        for (const fn of FEEDER_NODES) {
          const r = fn.dist * scale;
          const nx = cx + Math.cos(fn.angle) * r;
          const ny = cy + Math.sin(fn.angle) * r * 0.82;

          // Transmission Line with orthogonal SCADA elbow bend
          const midX = cx + Math.cos(fn.angle) * (r * 0.55);
          const midY = cy + Math.sin(fn.angle) * (r * 0.55) * 0.82;

          ctx.save();
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(midX, midY);
          ctx.lineTo(nx, ny);
          ctx.strokeStyle = state.faultActive ? '#f43f5e' : fn.color;
          ctx.globalAlpha = 0.45;
          ctx.lineWidth = 2.2;
          ctx.stroke();
          ctx.restore();

          // Animated Current Electron Packets traveling along feeder
          const packetT = ((now * 0.0008 * (state.hz / 50)) % 1);
          const px = cx + (nx - cx) * packetT;
          const py = cy + (ny - cy) * packetT;
          ctx.save();
          ctx.fillStyle = state.faultActive ? '#f43f5e' : '#fef08a';
          ctx.shadowColor = fn.color;
          ctx.shadowBlur = 10;
          ctx.beginPath();
          ctx.arc(px, py, 3.5 * scale, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();

          // Draw Sub-Satellites for GETCO 3 Substations
          if (fn.subs) {
            fn.subs.forEach((subName, sIdx) => {
              const sa = now * 0.0018 + (sIdx * Math.PI * 2) / 3;
              const sr = 32 * scale;
              const sx = nx + Math.cos(sa) * sr;
              const sy = ny + Math.sin(sa) * sr * 0.75;
              ctx.save();
              ctx.strokeStyle = 'rgba(16, 185, 129, 0.35)';
              ctx.beginPath();
              ctx.moveTo(nx, ny);
              ctx.lineTo(sx, sy);
              ctx.stroke();
              ctx.fillStyle = '#10b981';
              ctx.beginPath();
              ctx.arc(sx, sy, 4 * scale, 0, Math.PI * 2);
              ctx.fill();
              ctx.restore();
            });
          }

          // Feeder Breaker Node Box
          const boxR = Math.max(11, 14 * scale);
          hitNodes.push({ x: nx, y: ny, r: boxR + 12, target: fn.target, name: fn.label });

          ctx.save();
          ctx.fillStyle = '#040d1a';
          ctx.strokeStyle = state.faultActive ? '#f43f5e' : fn.color;
          ctx.lineWidth = 2.2;
          ctx.beginPath();
          ctx.roundRect(nx - boxR, ny - boxR, boxR * 2, boxR * 2, 6);
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = fn.color;
          ctx.font = `700 ${Math.max(8, Math.round(9 * scale))}px "JetBrains Mono", monospace`;
          ctx.textAlign = 'center';
          ctx.fillText(fn.id.toUpperCase(), nx, ny + 3);

          // High-Contrast Pill Label
          ctx.font = `700 ${Math.max(8.5, Math.round(9.5 * scale))}px "JetBrains Mono", monospace`;
          const tw = ctx.measureText(fn.label).width;
          const ly = ny + boxR + 13;
          ctx.fillStyle = 'rgba(2, 6, 23, 0.90)';
          ctx.strokeStyle = fn.color;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.roundRect(nx - tw / 2 - 6, ly - 9, tw + 12, 14, 4);
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = '#f8fafc';
          ctx.fillText(fn.label, nx, ly + 1.5);
          ctx.restore();
        }

        // 5. Draw Central 220 kV Master Busbar Hub ("MIHIR GADHVI")
        const hubR = Math.max(30, 42 * scale);
        hitNodes.push({ x: cx, y: cy, r: hubR + 8, target: '#bay-bus0', name: 'BUS 00: MIHIR GADHVI Master Hub' });

        ctx.save();
        const hubGlow = ctx.createRadialGradient(cx, cy, hubR * 0.2, cx, cy, hubR * 2.4);
        hubGlow.addColorStop(0, state.faultActive ? 'rgba(244, 63, 94, 0.85)' : 'rgba(6, 182, 212, 0.75)');
        hubGlow.addColorStop(0.5, state.faultActive ? 'rgba(244, 63, 94, 0.25)' : 'rgba(16, 185, 129, 0.25)');
        hubGlow.addColorStop(1, 'rgba(6, 182, 212, 0)');
        ctx.fillStyle = hubGlow;
        ctx.beginPath();
        ctx.arc(cx, cy, hubR * 2.4, 0, Math.PI * 2);
        ctx.fill();

        // Octagonal / Circular Substation Core
        ctx.fillStyle = '#040d1a';
        ctx.strokeStyle = state.faultActive ? '#f43f5e' : '#22d3ee';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.arc(cx, cy, hubR, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = '#22d3ee';
        ctx.font = `700 ${Math.max(8, Math.round(8.5 * scale))}px "JetBrains Mono", monospace`;
        ctx.textAlign = 'center';
        ctx.fillText(`${state.kv} kV BUS`, cx, cy - 11);

        ctx.fillStyle = '#ffffff';
        ctx.font = `700 ${Math.max(9.5, Math.round(11 * scale))}px "Space Grotesk", sans-serif`;
        ctx.fillText('MIHIR', cx, cy + 2);
        ctx.fillText('GADHVI', cx, cy + 14);
        ctx.restore();

        requestAnimationFrame(drawGridFrame);
      }

      requestAnimationFrame(drawGridFrame);

      canvas.addEventListener('click', (e) => {
        for (const item of hitNodes) {
          if (Math.hypot(e.clientX - item.x, e.clientY - item.y) <= item.r) {
            document.body.classList.remove('full-grid-mode');
            document.getElementById('full-grid-label').textContent = 'Full Grid View';
            const targetEl = document.querySelector(item.target);
            if (targetEl) {
              targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
              showToast(`SCADA Lock: ${item.name}`);
            }
            break;
          }
        }
      });
    }

    // =========================================================================
    // INITIALIZE CONTROLS & LISTENERS
    // =========================================================================
    window.addEventListener('DOMContentLoaded', () => {
      renderOltcTaps();
      renderEquipSwitches();
      renderScadaSkills();
      initPowerGridCanvas();

      if (window.lucide) lucide.createIcons();

      // Copy Terminals
      document.querySelectorAll('.copy-term').forEach(btn => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-copy');
          const lbl = btn.getAttribute('data-label');
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(val).then(() => showToast(`Copied ${lbl}: ${val}`));
          } else {
            showToast(`${lbl}: ${val}`);
          }
        });
      });

      // Busbar Voltage & Frequency Sliders
      function updateBusTelemetry() {
        state.kv = Number(document.getElementById('kv-slider').value);
        state.hz = Number(document.getElementById('hz-slider').value);
        document.getElementById('kv-slider-val').textContent = `${state.kv} kV`;
        document.getElementById('hz-slider-val').textContent = `${state.hz.toFixed(1)} Hz`;
        document.getElementById('bus-voltage-badge').textContent = `${state.kv}.0 kV | ${state.hz.toFixed(1)} Hz`;
        document.getElementById('stage-kv-readout').textContent =
          `V_bus: ${state.kv}.0 kV | f: ${state.hz.toFixed(2)} Hz | PF: 0.98 Lag`;
      }
      document.getElementById('kv-slider').addEventListener('input', updateBusTelemetry);
      document.getElementById('hz-slider').addEventListener('input', updateBusTelemetry);

      // Full Grid View Toggle
      document.getElementById('full-grid-btn').addEventListener('click', () => {
        document.body.classList.toggle('full-grid-mode');
        const active = document.body.classList.contains('full-grid-mode');
        document.getElementById('full-grid-label').textContent = active ? 'Show Bays' : 'Full Grid View';
        showToast(active ? 'Full-Screen 220 kV Power Grid Mode (Click any feeder node or Show Bays)' : 'Restored SCADA Control Bays');
      });

      // Simulated 3-Phase Fault & Relay Trip Sequence
      document.getElementById('fault-test-btn').addEventListener('click', () => {
        if (state.faultActive) return;
        state.faultActive = true;
        const badge = document.getElementById('scada-active-bay');
        badge.className = 'px-2.5 py-0.5 rounded-md text-[10px] font-mono-scada font-bold bg-rose-500/30 text-rose-200 border border-rose-400 animate-pulse';
        badge.textContent = '⚠ 3Φ FAULT DETECTED • RELAY 86 TRIP!';
        showToast('⚠ Simulated 220 kV Fault Injected → Protection Relay Tripping...');

        setTimeout(() => {
          state.faultActive = false;
          badge.className = 'px-2.5 py-0.5 rounded-md text-[10px] font-mono-scada font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-400/40';
          badge.textContent = '● FAULT CLEARED • AUTO-RECLOSED (50.00 Hz)';
          showToast('✓ Circuit Breaker Cleared Fault & Auto-Reclosed Successfully!');
        }, 2600);
      });

      // GETCO 3 Substation Bay Switcher
      document.querySelectorAll('.sub-bay-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-sub-bay');
          document.getElementById('substation-bay-summary').innerHTML = SUB_BAY_INFO[key];
          document.querySelectorAll('.sub-bay-btn').forEach(b => {
            const act = b.getAttribute('data-sub-bay') === key;
            b.className = act
              ? 'sub-bay-btn p-3 rounded-xl text-left font-mono-scada transition-all bg-emerald-400 text-slate-950 font-bold shadow-md'
              : 'sub-bay-btn p-3 rounded-xl text-left font-mono-scada transition-all bg-slate-900 text-slate-200 border border-slate-700 hover:border-emerald-400';
          });
        });
      });

      // PLC Ladder Logic Rung Simulator (Automatic Plant Watering)
      function updatePlcRung() {
        const m = Number(document.getElementById('mcu-moist-slider').value);
        const f = Number(document.getElementById('mcu-fert-slider').value);
        const moistContactClosed = m < 45;
        const fertContactClosed = f >= 35;
        const pumpEnergized = moistContactClosed && fertContactClosed;

        document.getElementById('mcu-moist-val').textContent = moistContactClosed ? `${m}% (Dry < 45%)` : `${m}% (Wet >= 45%)`;
        document.getElementById('mcu-fert-val').textContent = `${f}% (${fertContactClosed ? 'Optimal' : 'Low'})`;

        const cMoist = document.getElementById('rung-contact-moist');
        const cFert = document.getElementById('rung-contact-fert');
        const cPump = document.getElementById('rung-coil-pump');
        const badge = document.getElementById('plc-coil-water');

        cMoist.className = moistContactClosed
          ? 'px-2 py-1 rounded bg-emerald-500/25 text-emerald-300 border border-emerald-400 font-bold'
          : 'px-2 py-1 rounded bg-slate-800 text-slate-400 border border-slate-700';
        cFert.className = fertContactClosed
          ? 'px-2 py-1 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-400 font-bold'
          : 'px-2 py-1 rounded bg-rose-500/20 text-rose-300 border border-rose-400';

        if (pumpEnergized) {
          cPump.className = 'px-2.5 py-1 rounded-full bg-emerald-400 text-slate-950 font-bold';
          cPump.textContent = '( Y0: WATER PUMP ON )';
          badge.className = 'px-2.5 py-1 rounded-md text-xs font-mono-scada font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40';
          badge.textContent = 'COIL Y0 (PUMP): ENERGIZED';
        } else {
          cPump.className = 'px-2.5 py-1 rounded-full bg-slate-800 text-slate-400 border border-slate-700';
          cPump.textContent = '( Y0: PUMP STANDBY )';
          badge.className = 'px-2.5 py-1 rounded-md text-xs font-mono-scada font-bold bg-slate-800 text-slate-400 border border-slate-700';
          badge.textContent = 'COIL Y0 (PUMP): DE-ENERGIZED';
        }
      }
      document.getElementById('mcu-moist-slider').addEventListener('input', updatePlcRung);
      document.getElementById('mcu-fert-slider').addEventListener('input', updatePlcRung);

      // Fertilizer Dispenser Interval Timer
      document.getElementById('dispense-pulse-btn').addEventListener('click', () => {
        if (state.hopperPct <= 10) {
          showToast('Hopper Empty! Click Reload Hopper.');
          return;
        }
        state.hopperPct = Math.max(0, state.hopperPct - 15);
        state.fertBatches += 1;
        document.getElementById('fert-batch-badge').textContent = `TIMER T1 BATCHES: ${state.fertBatches}`;
        document.getElementById('hopper-status-readout').textContent =
          `Hopper Level: ${state.hopperPct}% | Dispensed Batch #${state.fertBatches}`;
        showToast(`Executed Timed Fertilizer Dispense Batch #${state.fertBatches}`);
      });

      document.getElementById('reset-hopper-btn').addEventListener('click', () => {
        state.hopperPct = 100;
        document.getElementById('hopper-status-readout').textContent = 'Hopper Level: 100% | Reloaded';
        showToast('Hopper Reloaded to 100%');
      });

      // Dispatch Languages
      document.querySelectorAll('.disp-lang-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const l = btn.getAttribute('data-disp-lang');
          document.getElementById('disp-lang-readout').textContent = DISPATCH_LANGS[l];
          document.querySelectorAll('.disp-lang-btn').forEach(b => {
            const act = b.getAttribute('data-disp-lang') === l;
            b.className = act
              ? 'disp-lang-btn py-1.5 px-2 rounded-lg text-xs font-mono-scada font-bold bg-cyan-400 text-slate-950'
              : 'disp-lang-btn py-1.5 px-2 rounded-lg text-xs font-mono-scada bg-slate-900 text-slate-200 border border-slate-700';
          });
        });
      });

      // Scroll Spy
      const bays = document.querySelectorAll('.scada-bay');
      const navs = document.querySelectorAll('.feeder-nav-link');
      window.addEventListener('scroll', () => {
        let activeIdx = 0;
        let bayTitle = '● GRID ONLINE • 50.00 Hz';
        bays.forEach((b, idx) => {
          const rect = b.getBoundingClientRect();
          if (rect.top <= window.innerHeight * 0.45) {
            activeIdx = idx;
            bayTitle = b.getAttribute('data-bay-title') || bayTitle;
          }
        });
        if (!state.faultActive) {
          document.getElementById('scada-active-bay').textContent = bayTitle;
        }
        navs.forEach((n, i) => {
          n.className = i === activeIdx
            ? 'feeder-nav-link px-2.5 py-1.5 rounded-lg bg-cyan-400 text-slate-950 font-bold transition-all'
            : 'feeder-nav-link px-2.5 py-1.5 rounded-lg text-slate-300 hover:text-white transition-all';
        });
      });

      // Resume Sheet Modal
      const modal = document.getElementById('resume-modal');
      document.getElementById('open-resume-modal-btn').addEventListener('click', () => {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      });
      document.getElementById('close-resume-modal-btn').addEventListener('click', () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      });
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
      });
    });
  </script>
</body>
</html>
